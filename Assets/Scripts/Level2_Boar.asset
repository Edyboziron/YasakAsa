MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8e5b6358ee0772646a094f31078778f2, type: 3}
  m_Name: Level2_Boar
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: 
  lines:
  - name: "Anlat\u0131c\u0131"
    characterIcon: {fileID: 5739202372172849169, guid: a35062c9a8892e24baacf48705ae1514, type: 3}
    text: "Orman\u0131n kenar\u0131ndan uzakla\u015Ft\u0131n. A\u011Fa\xE7lar s\u0131kla\u015F\u0131yor,
      g\xF6lgeler uzuyor. Kokuyu al\u0131yor musun? <color=#E74C3C>\xC7\xFCr\xFCm\xFC\u015Fl\xFCk</color>
      art\u0131yor."
  - name: "Anlat\u0131c\u0131"
    characterIcon: {fileID: 5739202372172849169, guid: a35062c9a8892e24baacf48705ae1514, type: 3}
    text: "Art\u0131k \xE7iftlik hayvanlar\u0131 yok. Bu <color=#E74C3C>Domuz</color>
      \xE7amurda oynamay\u0131 b\u0131rakal\u0131 \xE7ok oldu."
  - name: "Anlat\u0131c\u0131"
    characterIcon: {fileID: 5739202372172849169, guid: a35062c9a8892e24baacf48705ae1514, type: 3}
    text: "Deri sertle\u015Fmi\u015F, di\u015Fler uzam\u0131\u015F. Dikkat et, seni
      <color=#E74C3C>ezip ge\xE7mek</color> i\xE7in sab\u0131rs\u0131zlan\u0131yor!"
  - name: Yaban Domuzu
    characterIcon: {fileID: 2934709672142857923, guid: 3e6adf0b2dd86c94b8388ca055836b5d, type: 3}
    text: "Ooo, ayakkab\u0131lar\u0131n ne kadar da... <color=#FFD700>temiz</color>.
      Mideni mi buland\u0131r\u0131yorum sosyete \xE7ocu\u011Fu? Gel buraya! Seni
      \xF6yle bir \xE7i\u011Fneyece\u011Fim ki, <color=#E74C3C>annen bile seni \xE7amurdan
      ay\u0131rt edemeyecek!</color>"
