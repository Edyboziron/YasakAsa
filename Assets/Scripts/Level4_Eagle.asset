  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8e5b6358ee0772646a094f31078778f2, type: 3}
  m_Name: Level4_Eagle
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: 
  lines:
  - name: "Anlat\u0131c\u0131"
    characterIcon: {fileID: 5739202372172849169, guid: a35062c9a8892e24baacf48705ae1514, type: 3}
    text: "Yere bakmaktan boynun tutuldu san\u0131r\u0131m. Ama tehlike art\u0131k
      sadece topraktan gelmiyor. Ba\u015F\u0131n\u0131 kald\u0131r."
  - name: "Anlat\u0131c\u0131"
    characterIcon: {fileID: 5739202372172849169, guid: a35062c9a8892e24baacf48705ae1514, type: 3}
    text: "Do\u011Fan\u0131n en asil avc\u0131s\u0131 bile bu hastal\u0131ktan ka\xE7amad\u0131.
      O <color=#E74C3C>Kartal</color>... Av\u0131n\u0131 de\u011Fil, ruhunu ar\u0131yor
      gibi."
  - name: "Anlat\u0131c\u0131"
    characterIcon: {fileID: 5739202372172849169, guid: a35062c9a8892e24baacf48705ae1514, type: 3}
    text: "Ve o v\u0131z\u0131lt\u0131... Bal yapmak i\xE7in de\u011Fil, <color=#E74C3C>kan\u0131n\u0131
      zehirlemek</color> i\xE7in geliyorlar. S\xFCr\xFCn\xFCn \xF6fkesine haz\u0131r
      ol."
  - name: "Ku\u015F\xE7uk"
    characterIcon: {fileID: 1533657226444166215, guid: 68479804f6f577e43bf4c36a1f70f152, type: 3}
    text: "G\xF6klerin krall\u0131\u011F\u0131 \xE7\xFCr\xFCd\xFC ama g\xF6zlerim
      hala keskin. \xC7al\u0131lar\u0131n aras\u0131na saklanabilece\u011Fini mi
      san\u0131yorsun k\xFC\xE7\xFCk fare? <color=#E74C3C>Kalbinin at\u0131\u015F\u0131n\u0131</color>
      buradan duyabiliyorum... Ve birazdan duracak"
